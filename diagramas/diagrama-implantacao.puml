@startuml

left to right direction

skinparam shadowing false
skinparam nodeStyle rectangle
skinparam componentStyle uml2

title Diagrama de Implantação - SGO

actor "Cliente" as Cliente

' =====================================================
' FRONTEND
' =====================================================

node "Cliente Web" {

    artifact "Next.js Frontend" as Front
}

Cliente --> Front : HTTPS

' =====================================================
' API
' =====================================================

node "Servidor API" {

    component "API REST" as API
}

Front --> API : REST/HTTPS

' =====================================================
' INTERFACES
' =====================================================

interface "ICompetições" as ICompeticoes
interface "IAtletas" as IAtletas
interface "IPaises" as IPaises
interface "ILocais" as ILocais
interface "IInscricoes" as IInscricoes
interface "IResultados" as IResultados
interface "IRelatorios" as IRelatorios

' =====================================================
' LINHA 1
' =====================================================

together {

cloud "AWS - Competições" {

    node "Docker - Competições" {

        package "Competições" {

            component "Serviço de Competições" as Competicoes

            interface "IDBCompeticoes" as IDBC

            database "PostgreSQL\nCompetições DB" as DBCompeticoes

            Competicoes -- ICompeticoes
            Competicoes --( IDBC :TCP/IP
            DBCompeticoes -- IDBC
        }
    }
}

cloud "AWS - Atletas" {

    node "Docker - Atletas" {

        package " Atletas" {

            component "Serviço de Atletas" as Atletas

            interface "IDBAtletas" as IDBA

            database "PostgreSQL\nAtletas DB" as DBAtletas

            Atletas -- IAtletas
            Atletas --( IDBA :TCP/IP
            DBAtletas -- IDBA
        }
    }
}

}

' =====================================================
' LINHA 2
' =====================================================

together {

cloud "AWS - Países" {

    node "Docker - Países" {

        package " Países" {

            component "Serviço de Países" as Paises

            interface "IDBPaises" as IDBP

            database "PostgreSQL\nPaíses DB" as DBPaises

            Paises -- IPaises
            Paises --( IDBP :TCP/IP
            DBPaises -- IDBP
        }
    }
}

cloud "AWS - Locais" {

    node "Docker - Locais" {

        package " Locais" {

            component "Serviço de Locais" as Locais

            interface "IDBLocais" as IDBL

            database "PostgreSQL\nLocais DB" as DBLocais

            Locais -- ILocais
            Locais --( IDBL :TCP/IP
            DBLocais -- IDBL
        }
    }
}

}

' =====================================================
' LINHA 3
' =====================================================

together {

cloud "AWS - Inscrições" {

    node "Docker - Inscrições" {

        package " Inscrições" {

            component "Serviço de Inscrições" as Inscricoes

            interface "IDBInscricoes" as IDBI

            database "PostgreSQL\nInscrições DB" as DBInscricoes

            Inscricoes -- IInscricoes
            Inscricoes --( IDBI
            DBInscricoes -- IDBI
        }
    }
}

cloud "AWS - Resultados" {

    node "Docker - Resultados" {

        package " Resultados" {

            component "Serviço de Resultados" as Resultados

            interface "IDBResultados" as IDBRes

            database "PostgreSQL\nResultados DB" as DBResultados

            Resultados -- IResultados
            Resultados --( IDBRes :TCP/IP
            DBResultados -- IDBRes
        }
    }
}

}

' =====================================================
' LINHA 4
' =====================================================

cloud "AWS - Relatórios" {

    node "Docker - Relatórios" {

        package " Relatórios" {

            component "Serviço de Relatórios" as Relatorios

            interface "IDBRelatorio" as IDBR

            database "PostgreSQL\nRelatórios DB" as DBRelatorios

            Relatorios -- IRelatorios
            Relatorios --( IDBR :TCP/IP
            DBRelatorios -- IDBR
        }
    }
}

' =====================================================
' API REQUER INTERFACES
' =====================================================

API --( ICompeticoes : REST
API --( IAtletas : REST
API --( IPaises : REST
API --( ILocais : REST
API --( IInscricoes : REST
API --( IResultados : REST
API --( IRelatorios : REST

' =====================================================
' SERVIÇOS REQUEREM INTERFACES
' =====================================================

Competicoes --( IAtletas 
Competicoes --( IPaises
Competicoes --( ILocais

Inscricoes --( ICompeticoes

Resultados --( ICompeticoes
Resultados --( IAtletas

Relatorios --( IResultados
Relatorios --( IPaises

@enduml